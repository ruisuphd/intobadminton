# For GitHub Pages project sites, set to your repo name, e.g. /intobadminton
# Leave empty for local dev and Vercel/Firebase root deploys
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://intobadminton.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Use the AdSense publisher ID, e.g. ca-pub-0000000000000000. This also emits
# the google-adsense-account meta tag used during AdSense site connection.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9641207581771694
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
# disabled = safest default. cmp_tcf = only after Google-certified CMP/IAB TCF is live.
NEXT_PUBLIC_ADSENSE_MODE=disabled
# Production EEA/UK/CH personalized ads require a Google-certified CMP.
NEXT_PUBLIC_CMP_PROVIDER=
# Sitewide kill-switch for manufacturer-hosted product images. Default: enabled.
# Set to "false" to disable hot-linked manufacturer product images globally
# (e.g. on a takedown notice). "own" and "amazon" image sources are unaffected.
NEXT_PUBLIC_ALLOW_MANUFACTURER_IMAGES=true

# Affiliate partner tags. Leave empty until each program is approved; the
# `<AffiliateLink>` component will still render the disclosure chip and a
# rel="sponsored" link, just without a partner tag appended.
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=
NEXT_PUBLIC_AMAZON_UK_ASSOCIATES_TAG=
NEXT_PUBLIC_BUTTONDOWN_USERNAME=
# Optional Cloudflare Worker URL for HelpfulReaction aggregate counts (see workers/reactions/).
NEXT_PUBLIC_REACTIONS_API_URL=
