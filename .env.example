# For GitHub Pages project sites, set to your repo name, e.g. /intobadminton
# Leave empty for local dev and Vercel/Firebase root deploys
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://intobadminton.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Use the AdSense publisher ID, e.g. ca-pub-0000000000000000. This also emits
# the google-adsense-account meta tag used during AdSense site connection.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
# disabled = safest default. cmp_tcf = only after Google-certified CMP/IAB TCF is live.
NEXT_PUBLIC_ADSENSE_MODE=disabled
# Production EEA/UK/CH personalized ads require a Google-certified CMP.
NEXT_PUBLIC_CMP_PROVIDER=
# Buttondown newsletter username (the part after buttondown.email/). Leave blank
# to hide the signup form entirely.
NEXT_PUBLIC_BUTTONDOWN_USERNAME=
