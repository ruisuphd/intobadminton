{
  "name": "intobadminton",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-product-images.mjs && node scripts/generate-product-display-names.mjs && node scripts/generate-catalog-stats.mjs && node scripts/generate-home-featured.mjs",
    "build": "next build",
    "postbuild": "node scripts/generate-legacy-redirects.mjs && node scripts/generate-blog-redirects.mjs && node scripts/generate-feed.mjs && node scripts/check-source-attribution.mjs && node scripts/postbuild-seo-audit.mjs",
    "start": "npx -y serve@latest out",
    "lint": "eslint && node scripts/check-glossary-links.mjs --warn",
    "blog:import": "python3 scripts/blog-en-persona-normalize.py 2>/dev/null || true && python3 scripts/blog-import-option-b.py",
    "blog:sync": "node scripts/sync-blogs-drop.mjs",
    "blog:check": "node scripts/check-new-blog-sources.mjs",
    "blog:validate": "node scripts/blog-validate-20pass.mjs",
    "home:featured": "node scripts/generate-home-featured.mjs",
    "test:e2e": "playwright test",
    "lint:eslint": "eslint",
    "lint:glossary": "node scripts/check-glossary-links.mjs --warn",
    "lint:glossary:strict": "node scripts/check-glossary-links.mjs",
    "lint:lighthouse": "npx -y @lhci/cli@0.14.x autorun",
    "lint:lighthouse:baseline": "node scripts/lighthouse-baseline.mjs compare",
    "capture:lighthouse:baseline": "node scripts/lighthouse-baseline.mjs capture",
    "lint:crux-baseline": "node --experimental-strip-types scripts/crux-baseline.mjs validate",
    "lint:gsc-baseline": "node --experimental-strip-types scripts/gsc-baseline.mjs validate",
    "lint:gsc-baseline:compare": "node --experimental-strip-types scripts/gsc-baseline.mjs compare",
    "lint:search-baseline": "node scripts/search-baseline.mjs",
    "lint:catalog-baseline": "node scripts/catalog-baseline.mjs",
    "lint:discovery-baseline": "node scripts/discovery-parity.mjs",
    "lint:discovery-baselines": "node scripts/discovery-baselines.mjs",
    "lint:finder-baseline": "node scripts/finder-baseline.mjs",
    "lint:results-url-baseline": "node scripts/results-url-baseline.mjs",
    "lint:compare-baseline": "node scripts/compare-baseline.mjs",
    "lint:review-product-map-baseline": "node scripts/review-product-map-baseline.mjs",
    "lint:pdp-baseline": "node scripts/pdp-baseline.mjs",
    "lint:best-baseline": "node scripts/best-baseline.mjs",
    "lint:product-funnel-baselines": "node scripts/product-funnel-baselines.mjs",
    "lint:editorial-baselines": "node scripts/editorial-baselines.mjs",
    "lint:all-baselines": "node scripts/all-baselines.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sharp": "^0.34.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
